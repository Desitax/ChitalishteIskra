<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChitalishteIskra</title>


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Merriweather:wght@400;700&display=swap" rel="stylesheet">
    @*  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"> *@

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ChitalishteIskra.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    НЧ „Искра - 1860“
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Начало</a>
                        </li>


                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Читалището
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="About" asp-action="History">История</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Statutes">Устав</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Board">Настоятелство</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Team">Екип</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Documents">Документи</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Projects">Проекти</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Групи и школи
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="ANPT">АНПТ</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="Babsbg">Бабсбг</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="Iskritsa">ВС „Искрица”</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="Sevtopolis">ВС „Севтополис”</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="Ekarte">Студио за модерен балет „Екарте”</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="PetkoStainov">СХ „Петко Стайнов”</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="DetskaTeatralna">Детска театрална школа</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="MladejkaTeatralna">Младежка театрална студия</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="ArtSchool">Школа по изкуствата „Емануил Манолов”</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="Blue">Школа по изобразително изкуство „Синьо”</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="SportniTantsi">Школа по спортни танци</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Index">Събития</a>
                        </li>   

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Функционалности
                                </a>
                                <ul class="dropdown-menu">


                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Users" asp-action="PendingTeachers">
                                                Регистрация на учител
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" asp-controller="Image" asp-action="Upload">
                                                Качи снимка
                                            </a>

                                            <a class="dropdown-item" asp-controller="Image" asp-action="UploadFile">
                                                Качи документ
                                                </a>
                                        </li>
                                    }

                                    @if (User.IsInRole("Admin") || User.IsInRole("Parent") || User.IsInRole("Student"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="BookLessons" asp-action="Index">
                                                Запази час онлайн
                                            </a>
                                        </li>
                                    }

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Lessons" asp-action="Index">
                                                Уроци
                                            </a>
                                        </li>
                                    }

                                    <li>
                                        <a class="dropdown-item" asp-controller="Groups" asp-action="Index">
                                            Възрастови групи
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="TeacherAvailabilities" asp-action="Index">
                                            Свободни часове
                                        </a>
                                    </li>

                                </ul>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Stage" asp-action="Stage">Сцена</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="News" asp-action="Index">Актуално</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Gallery" asp-action="Index">Галерия</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contact" asp-action="Index">Контакти</a>
                        </li>

                    </ul>

                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>