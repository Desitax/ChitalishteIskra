<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChitalishteIskra</title>
@* 
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
 *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ChitalishteIskra.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    НЧ „Искра - 1860“
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Начало</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="BookLessons" asp-action="Index">
                                Запази час онлайн
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Index">Събития</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Lessons" asp-action="Index">Lessons</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                Читалището
                            </a>

                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="About" asp-action="History">История</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Statutes">Устав</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Board">Настоятелство</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Team">Екип</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Documents">Документи</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Projects">Проекти</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Groups" asp-action="Index">Групи и школи</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Stage" asp-action="Index">Сцена</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="News" asp-action="Index">Актуално</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Gallery" asp-action="Index">Галерия</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contact" asp-action="Index">Контакти</a>
                        </li>

                    </ul>

                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>