<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChitalishteIskra</title>

    <link href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Merriweather:wght@400;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ChitalishteIskra.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
            <div class="container-fluid">

                <a class="navbar-brand site-brand" asp-controller="Home" asp-action="Index">
                    <img src="https://res.cloudinary.com/dxloy3tkq/image/upload/v1776552112/cf2trljhgtoleyc5ajxr.png"
                         alt="НЧ Искра-1860"
                         class="site-brand-logo" />
                    <span class="site-brand-text">НЧ „Искра - 1860“</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav"
                        aria-controls="mainNav"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">За нас</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Читалището
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="About" asp-action="History">История</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Statutes">Устав</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Board">Настоятелство</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Team">Екип</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Documents">Документи</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Projects">Проекти</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Групи и школи
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="ANPT">АНПТ</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="Babsbg">Бабсбг</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="Iskritsa">ВС „Искрица”</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="Sevtopolis">ВС „Севтополис”</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="PetkoStainov">СХ „Петко Стайнов”</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="DetskaTeatralna">Детска театрална школа</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="MladejkaTeatralna">Младежка театрална студия</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="ArtSchool">Школа по изкуствата „Емануил Манолов”</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="Blue">Школа по изобразително изкуство „Синьо”</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="SportniTantsi">Школа по спортни танци</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Index">Събития</a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var isAdmin = User.IsInRole("Admin");
                            var isTeacher = User.IsInRole("Teacher");
                            var isStudent = User.IsInRole("Student");

                            if (isAdmin || isTeacher || isStudent)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Управление
                                    </a>

                                    <ul class="dropdown-menu">

                                        @if (isAdmin)
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="Users" asp-action="PendingTeachers">
                                                    Регистрации на учители
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item" asp-controller="Image" asp-action="Upload">
                                                    Качи снимка
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item" asp-controller="Contact" asp-action="Messages">
                                                    Съобщения
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item" asp-controller="Image" asp-action="UploadFile">
                                                    Качи документ
                                                </a>
                                            </li>

                                            <li><hr class="dropdown-divider"></li>

                                            <li>
                                                <a class="dropdown-item" asp-controller="Lessons" asp-action="Index">
                                                    Предмети
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item" asp-controller="TeacherLessons" asp-action="Index">
                                                    Назначаване на предмет
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item" asp-controller="BookLessons" asp-action="Index">
                                                    Запазени уроци
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item" asp-controller="Events" asp-action="Create">
                                                    Добави събитие
                                                </a>
                                            </li>
                                        }

                                        @if (isTeacher)
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="Lessons" asp-action="Create">
                                                    Добави предмет
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item" asp-controller="Groups" asp-action="Index">
                                                    Възрастови групи
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item" asp-controller="TeacherAvailabilities" asp-action="Index">
                                                    Работно време
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item" asp-controller="BookLessons" asp-action="Index">
                                                    Запазени уроци
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item" asp-controller="BookLessons" asp-action="CreateGroup">
                                                    Създай групов урок
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item" asp-controller="Events" asp-action="Create">
                                                    Добави събитие
                                                </a>
                                            </li>
                                        }

                                        @if (isStudent)
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="BookLessons" asp-action="Index">
                                                    Запазени уроци
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item" asp-controller="BookLessons" asp-action="Create">
                                                    Запази индивидуален урок
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item" asp-controller="BookLessons" asp-action="GroupInvitations">
                                                    Моите групови покани
                                                </a>
                                            </li>
                                        }

                                    </ul>
                                </li>
                            }
                        }

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Stage" asp-action="Stage">Сцена</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Gallery" asp-action="Index">Галерия</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contact" asp-action="Index">Контакти</a>
                        </li>

                    </ul>

                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer mt-4">
        <div class="container">
            <div class="row g-4 align-items-start">

                <div class="col-lg-5">
                    <h5 class="footer-title">НЧ „Искра - 1860”</h5>

                    <p class="mb-3">
                        <i class="bi bi-geo-alt-fill me-2"></i>
                        6100, гр. Казанлък, ул. „Искра” 1
                    </p>

                    <p class="mb-3">
                        <i class="bi bi-telephone-fill me-2"></i>
                        <a href="tel:+35943162986">+35943162986</a>
                    </p>

                    <p class="mb-0">
                        <i class="bi bi-envelope-fill me-2"></i>
                        <a href="mailto:iskrakz@abv.bg">iskrakz@abv.bg</a>
                    </p>
                </div>

                <div class="col-lg-4">
                    <h5 class="footer-title">Полезни връзки</h5>

                    <ul class="footer-links">
                        <li>
                            <a asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill me-2"></i>За нас
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Contact" asp-action="Index">
                                <i class="bi bi-person-lines-fill me-2"></i>Контакти
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home" asp-action="Donate">
                                <i class="bi bi-heart-fill me-2"></i>Дарителска сметка
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Events" asp-action="Index">
                                <i class="bi bi-calendar-event-fill me-2"></i>Събития
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-lg-3">
                    <h5 class="footer-title">Социални мрежи</h5>

                    <div class="footer-socials">

                        <a href="https://www.facebook.com/iskra1860" target="_blank">
                            <i class="bi bi-facebook me-2"></i>Facebook
                        </a>

                        <a href="https://www.instagram.com/iskra_1860" target="_blank">
                            <i class="bi bi-instagram me-2"></i>Instagram
                        </a>

                        <a href="https://www.youtube.com/channel/UCvMTEwMZZ_Fv0odKx3M8Y8g" target="_blank">
                            <i class="bi bi-youtube me-2"></i>YouTube
                        </a>

                    </div>
                </div>

            </div>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>

    <script>
        const lightbox = GLightbox({
            selector: '.glightbox',
            touchNavigation: true,
            loop: true,
            closeButton: true,
            zoomable: true
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>