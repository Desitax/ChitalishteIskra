@model IEnumerable<ChitalishteIskra.Models.Gallery.GalleryAlbumViewModel>
@{
    ViewData["Title"] = "Галерия";
}

<style>
    .gallery-page {
        padding: 2.5rem 0 4rem 0;
    }

    .gallery-header {
        background: linear-gradient(135deg, #7b001c, #c13b00);
        color: #fff;
        padding: 2.5rem;
        border-radius: 24px;
        box-shadow: 0 18px 40px rgba(123, 0, 28, 0.18);
        margin-bottom: 2.5rem;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.75rem;
    }

    .album-card {
        display: block;
        text-decoration: none;
        background: #fff;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.08);
        transition: transform .25s ease, box-shadow .25s ease;
        height: 100%;
        color: inherit;
    }

        .album-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 22px 40px rgba(0, 0, 0, 0.14);
            color: inherit;
        }

    .album-card-image-wrap {
        position: relative;
        overflow: hidden;
        height: 280px;
    }

    .album-card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .45s ease;
    }

    .album-card:hover .album-card-image {
        transform: scale(1.08);
    }

    .album-card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,.72), rgba(0,0,0,.12));
        display: flex;
        align-items: end;
        padding: 1rem;
    }

    .album-card-badge {
        background: rgba(255,255,255,.92);
        color: #8b0000;
        padding: .4rem .8rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: .9rem;
    }

    .album-card-body {
        padding: 1.25rem 1.25rem 1.5rem 1.25rem;
    }

    .album-card-title {
        font-size: 1.45rem;
        font-weight: 700;
        color: #8b0000;
        margin-bottom: .75rem;
    }

    .album-card-description {
        color: #4b5563;
        margin-bottom: 0;
    }

    .album-card-link {
        display: inline-block;
        margin-top: 1rem;
        font-weight: 700;
        color: #8b0000;
    }
</style>

<section class="gallery-page">
    <div class="gallery-header">
        <h1 class="mb-3">Галерия</h1>
    </div>

    <div class="gallery-grid">
        @foreach (var album in Model)
        {
            <a asp-controller="Gallery"
               asp-action="Details"
               asp-route-id="@album.Slug"
               class="album-card">
                <div class="album-card-image-wrap">
                    <img src="@album.CoverImageUrl" alt="@album.Title" class="album-card-image" />
                    <div class="album-card-overlay">
                        <span class="album-card-badge">@album.PhotoCount снимки</span>
                    </div>
                </div>

                <div class="album-card-body">
                    <h2 class="album-card-title">@album.Title</h2>
                    <span class="album-card-link">Виж галерията →</span>
                </div>
            </a>
        }
    </div>
</section>
