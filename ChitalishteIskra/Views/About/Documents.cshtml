@{
    ViewData["Title"] = "Документи";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background: #fff9e8;
    }

    .documents-page {
        background: #fff9e8;
        min-height: 100vh;
    }

    .documents-hero {
        background: linear-gradient(135deg, #8f1d40, #b23a48, #d47b4a);
        color: #fff;
        border-radius: 28px;
        padding: 56px 24px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    }

    .documents-hero h1 {
        margin: 0 0 12px 0;
        font-size: 2.8rem;
        font-weight: 700;
    }

    .documents-hero p {
        margin: 0;
        font-size: 1.08rem;
        opacity: 0.96;
    }

    .documents-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 24px;
        margin-top: 34px;
    }

    .document-card {
        background: #ffffff;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(123, 30, 58, 0.08);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .document-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 18px 34px rgba(0, 0, 0, 0.14);
        }

    .document-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: linear-gradient(135deg, #7b1e3a, #b23a48);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 18px;
        box-shadow: 0 10px 20px rgba(123, 30, 58, 0.22);
    }

    .document-badge {
        display: inline-block;
        background: #f8e4bc;
        color: #7b1e3a;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 999px;
        margin-bottom: 14px;
    }

    .document-title {
        color: #7b1e3a;
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .document-text {
        color: #4b5563;
        line-height: 1.65;
        margin-bottom: 20px;
        flex-grow: 1;
    }

    .document-link {
        display: inline-block;
        text-decoration: none;
        background: linear-gradient(135deg, #8f1d40, #b23a48);
        color: white;
        padding: 11px 18px;
        border-radius: 12px;
        font-weight: 600;
        transition: opacity 0.2s ease, transform 0.2s ease;
        border: none;
    }

        .document-link:hover {
            opacity: 0.92;
            transform: translateY(-2px);
            color: white;
        }

    @@media (max-width: 767.98px) {
        .documents-hero {
            padding: 40px 20px;
            border-radius: 24px;
        }

            .documents-hero h1 {
                font-size: 2.1rem;
            }

        .documents-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }
    }
</style>

<div class="documents-page">
    <div class="container py-5">
        <div class="documents-hero text-center mb-5">
            <h1>Документи</h1>
            <p>Официални документи на Народно читалище „Искра-1860“</p>
        </div>

        <div class="documents-grid">

            <div class="document-card">
                <div>
                    <div class="document-icon">DOCX</div>
                    <div class="document-badge">Отчет</div>
                    <div class="document-title">Отчет за дейността на НЧ "Искра-1860" за 2025 г.</div>
                    <p class="document-text">
                        Годишен отчет за дейността на читалището за 2025 година.
                    </p>
                </div>
                <div>
                    <a href="https://res.cloudinary.com/dxloy3tkq/raw/upload/v1776316520/отчет_2025%282%29-626a77c3e15a47cd8ec6c71159a1c40e.docx"
                       class="document-link"
                       onclick="return confirmDownload(this.href)">
                        Отвори документа
                    </a>
                </div>
            </div>

            <div class="document-card">
                <div>
                    <div class="document-icon">DOCX</div>
                    <div class="document-badge">Отчет</div>
                    <div class="document-title">Отчет за дейността на НЧ "Искра-1860" за 2024 г.</div>
                    <p class="document-text">
                        Годишен отчет за дейността на читалището за 2024 година.
                    </p>
                </div>
                <div>
                    <a href="https://res.cloudinary.com/dxloy3tkq/raw/upload/v1776316605/otchetenDokklad2024-0ae50b0da3aa4d7aa499fb732eb07731.docx"
                       class="document-link"
                       onclick="return confirmDownload(this.href)">
                        Отвори документа
                    </a>
                </div>
            </div>

            <div class="document-card">
                <div>
                    <div class="document-icon">PDF</div>
                    <div class="document-badge">Отчет</div>
                    <div class="document-title">Отчет за дейността на НЧ "Искра-1860" за 2023 г.</div>
                    <p class="document-text">
                        Годишен отчет за дейността на читалището за 2023 година.
                    </p>
                </div>
                <div>
                    <a href="https://res.cloudinary.com/dxloy3tkq/raw/upload/v1776316687/отчет_дейност_23-53f81e39ceeb448084157e789f6e7571.pdf"
                       class="document-link"
                       onclick="return confirmDownload(this.href)">
                        Отвори документа
                    </a>
                </div>
            </div>

            <div class="document-card">
                <div>
                    <div class="document-icon">DOCX</div>
                    <div class="document-badge">Отчет</div>
                    <div class="document-title">Отчет за дейността на НЧ "Искра-1860" за 2022 г.</div>
                    <p class="document-text">
                        Годишен отчет за дейността на читалището за 2022 година.
                    </p>
                </div>
                <div>
                    <a href="https://res.cloudinary.com/dxloy3tkq/raw/upload/v1776253465/22-ОТЧЕТ-ДЕЙНОСТ-НЧ-b75eee6916c845a8a9f2c0331dc8fdc4.docx"
                       class="document-link"
                       onclick="return confirmDownload(this.href)">
                        Отвори документа
                    </a>
                </div>
            </div>

            <div class="document-card">
                <div>
                    <div class="document-icon">PDF</div>
                    <div class="document-badge">Декларации</div>
                    <div class="document-title">Декларации на Настоятелството на НЧ "Искра-1860" по чл.19а от ЗНЧ</div>
                    <p class="document-text">
                        Официални декларации на настоятелството съгласно изискванията на закона.
                    </p>
                </div>
                <div>
                    <a href="https://res.cloudinary.com/dxloy3tkq/raw/upload/v1776253500/deklaracii-b92a19ff58d84b779460f25d39a71d99.pdf"
                       class="document-link"
                       onclick="return confirmDownload(this.href)">
                        Отвори документа
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    function confirmDownload(fileUrl) {
        const result = confirm("Искате ли да отворите документа?");
        if (result) {
            window.open(fileUrl, '_blank');
        }
        return false;
    }
</script>