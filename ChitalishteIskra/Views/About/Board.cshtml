@{
    ViewData["Title"] = "Настоятелство";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background: #fff9e8;
    }

    .board-page {
        background: #fff9e8;
    }

    .board-hero {
        background: linear-gradient(135deg, #7b1e3a, #b23a48, #d47b4a);
        color: white;
        border-radius: 24px;
        padding: 60px 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }

        .board-hero h1 {
            font-weight: 700;
            font-size: 2.4rem;
            margin-bottom: 15px;
        }

        .board-hero p {
            font-size: 1.08rem;
            margin-bottom: 0;
            opacity: 0.95;
        }

    .board-badge {
        display: inline-block;
        background-color: rgba(255,255,255,0.18);
        padding: 8px 16px;
        border-radius: 999px;
        font-size: 0.95rem;
        margin-top: 18px;
    }

    .board-section-title {
        color: #7b1e3a;
        font-weight: 700;
        margin-bottom: 24px;
        text-align: center;
    }

    .board-card {
        background: #ffffff;
        border: none;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        padding: 24px;
        height: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .board-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
        }

    .board-member-card {
        background: #ffffff;
        border: none;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        padding: 22px;
        height: 100%;
        text-align: center;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .board-member-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
        }

    .board-member-number {
        width: 46px;
        height: 46px;
        margin: 0 auto 16px auto;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #7b1e3a, #b23a48);
        color: white;
        font-weight: 700;
        font-size: 1.05rem;
        box-shadow: 0 6px 16px rgba(123, 30, 58, 0.25);
    }

    .board-member-name {
        color: #7b1e3a;
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .board-member-role {
        color: #555;
        font-size: 1rem;
        line-height: 1.6;
        margin-bottom: 0;
    }

    .board-footer-box {
        background: #ffffff;
        border-left: 6px solid #b23a48;
        border-radius: 16px;
        padding: 25px;
        color: #333;
        line-height: 1.8;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.05);
    }

    @@media (max-width: 991.98px) {
        .board-hero {
            padding: 40px 22px;
        }

            .board-hero h1 {
                font-size: 2rem;
            }

        .board-card,
        .board-member-card {
            padding: 20px;
        }
    }
</style>

<div class="board-page">
    <div class="container py-5">
        <div class="board-hero text-center mb-5">
            <h1>Настоятелство на Народно читалище „Искра-1860“</h1>
            <p>
                Екипът, който ръководи дейността на читалището и работи за развитието
                на културния живот в Казанлък.
            </p>
            <div class="board-badge">Ръководен орган на читалището</div>
        </div>

        <h2 class="board-section-title">Състав на настоятелството</h2>

        <div class="row g-4 mb-5">
            <div class="col-lg-4 col-md-6">
                <div class="board-member-card">
                    <div class="board-member-number">1</div>
                    <div class="board-member-name">Теодора Иванова</div>
                    <p class="board-member-role">Председател</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="board-member-card">
                    <div class="board-member-number">2</div>
                    <div class="board-member-name">Василка Кирилова</div>
                    <p class="board-member-role">Зам.-председател</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="board-member-card">
                    <div class="board-member-number">3</div>
                    <div class="board-member-name">Стефка Денева</div>
                    <p class="board-member-role">Член на настоятелството</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="board-member-card">
                    <div class="board-member-number">4</div>
                    <div class="board-member-name">Иван Димов</div>
                    <p class="board-member-role">Член на настоятелството</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="board-member-card">
                    <div class="board-member-number">5</div>
                    <div class="board-member-name">Николай Тенев</div>
                    <p class="board-member-role">Член на настоятелството</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="board-member-card">
                    <div class="board-member-number">6</div>
                    <div class="board-member-name">Младен Станев</div>
                    <p class="board-member-role">Член на настоятелството</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="board-member-card">
                    <div class="board-member-number">7</div>
                    <div class="board-member-name">Румяна Григорова</div>
                    <p class="board-member-role">Член на настоятелството</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="board-member-card">
                    <div class="board-member-number">8</div>
                    <div class="board-member-name">Цветан Цочев</div>
                    <p class="board-member-role">Член на настоятелството</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="board-member-card">
                    <div class="board-member-number">9</div>
                    <div class="board-member-name">Петя Александрова</div>
                    <p class="board-member-role">Член на настоятелството</p>
                </div>
            </div>
        </div>

        <div class="board-footer-box">
            Настоятелството на Народно читалище „Искра-1860“ има ключова роля в
            организирането, развитието и поддържането на културната и обществена
            дейност на читалището, като съчетава традиции, отговорност и визия за бъдещето.
        </div>
    </div>
</div>