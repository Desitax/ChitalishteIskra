@{
    ViewData["Title"] = "История";

    var heroImage = "https://res.cloudinary.com/YOUR_CLOUD_NAME/image/upload/v1/chitalishte/history-hero.jpg";

    var image1 = "https://res.cloudinary.com/YOUR_CLOUD_NAME/image/upload/v1/chitalishte/history1.jpg";
}

<div class="container py-5">

    <!-- HERO -->
    <div class="rounded-4 overflow-hidden mb-5 text-white d-flex align-items-center"
         style="min-height: 320px;
         background: linear-gradient(rgba(0,0,0,.6), rgba(0,0,0,.4)),
         url('@heroImage') center/cover no-repeat;">

        <div class="p-5">
            <h1 class="fw-bold mb-3">История на НЧ „Искра-1860“</h1>
            <p class="mb-0 col-lg-8">
                Най-старият културен институт в град Казанлък и едно от първите читалища в България.
            </p>
        </div>
    </div>

    <!-- ПЪРВА СЕКЦИЯ СЪС СНИМКА -->
    <div class="history-card history-with-image">
        <div>
            <p>
                Народно читалище „Искра-1860“ е най-старият културен институт в град Казанлък
                и едно от първите читалища в България.
            </p>
            <p>
                Основано е през 1860 г. в период на национално пробуждане и засилени обществени
                противоречия, свързани с развитието на образованието и културата.
            </p>
        </div>

        <img src="@image1" class="history-img" alt="История" />
    </div>

    <!-- СЕКЦИЯ -->
    <div class="history-card">
        <h2 class="mb-3">Кризи и ново обществено съзнание</h2>
        <p>
            През 1858 г. напрежението в Казанлък достига своя връх – разрушено е главното училище,
            а учебната дейност е прекратена.
        </p>
        <p>
            В отговор местната общност организира възстановяване на образованието.
            Това води до формирането на ново поколение активни и обществено ангажирани хора.
        </p>
        <p>
            Паралелно с това се засилва и националното самосъзнание, както и стремежът
            към културна и духовна независимост.
        </p>
    </div>

    <!-- СЕКЦИЯ -->
    <div class="history-card">
        <h2 class="mb-3">1860 година – начало на нов етап</h2>
        <p>
            През 1860 г. се наблюдава обединение на местното население около общи цели.
        </p>
        <p>
            Възстановява се нормалната дейност на училищата и се създават условия
            за културно развитие.
        </p>
        <p>
            Икономическият подем и активните контакти с други български градове
            допринасят за възникването на идеи за създаване на културно-просветна институция.
        </p>
    </div>

    <!-- СЕКЦИЯ -->
    <div class="history-card">
        <h2 class="mb-3">Основаване на читалище „Искра“</h2>
        <p>
            На 27 декември 1860 г. група от около 40 млади и образовани казанлъчани
            основават Народно читалище „Искра“.
        </p>
        <p>
            То възниква с цел да предоставя достъп до знания, култура и образование
            на по-широк кръг от хора и бързо се утвърждава като важен духовен център.
        </p>
    </div>

    <!-- СЕКЦИЯ -->
    <div class="history-card">
        <h2 class="mb-3">Културен център с национално значение</h2>
        <p>
            През годините читалището се превръща във водещ културен център.
        </p>
        <p>
            В него се осъществяват значими събития като първото театрално представление
            в Казанлък, първи постановки на известни произведения и създаването
            на първото читалищно кино в България.
        </p>
        <p>
            От неговата дейност възникват редица културни институции, които имат
            важно значение за развитието на българската култура.
        </p>
    </div>

    <!-- СЕКЦИЯ -->
    <div class="history-card">
        <h2 class="mb-3">Читалището днес</h2>
        <p>
            Днес читалище „Искра-1860“ продължава да бъде средище на култура,
            образование и творчество.
        </p>
        <p>
            То съхранява културното наследство и същевременно се развива като
            съвременно място за културен живот и обществен диалог в Казанлък.
        </p>
    </div>

</div>