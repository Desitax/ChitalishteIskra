@model ChitalishteIskra.Models.Image.ImageUploadViewModel
@{
    ViewData["Title"] = "Качване на снимка";
}

<div class="container py-5">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-lg-8">
            <form method="post" enctype="multipart/form-data" class="card shadow-sm p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Picture" class="form-label">Избери снимка</label>
                    <input asp-for="Picture" accept="image/png, image/jpeg, image/jpg, image/gif, image/webp" class="form-control" />
                    <span asp-validation-for="Picture" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Качи в Cloudinary</button>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <div class="card shadow-sm mt-4 p-4">
                    <p class="text-success fw-bold">@ViewBag.Message</p>

                    <label class="form-label fw-bold">Получен URL:</label>
                    <input class="form-control mb-3" value="@Model.ImageUrl" readonly />

                    <img src="@Model.ImageUrl" alt="Качена снимка" class="img-fluid rounded" />
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
