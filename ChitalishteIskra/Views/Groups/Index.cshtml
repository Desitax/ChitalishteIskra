@using ChitalishteIskra.Models.Groups
@model IEnumerable<GroupIndexViewModel>

<h2 class="mb-3">Възрастови групи</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
{
    <a asp-action="Create" class="btn btn-primary mb-3">Добави група</a>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Име</th>
            <th>Учител</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.TeacherName</td>
                <td>
                    @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1">
                            Поправи
                        </a>

                        <form asp-action="Delete" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Сигурен ли си, че искаш да изтриеш тази група?');">
                                Изтрий
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>