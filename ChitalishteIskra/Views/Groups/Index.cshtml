@using ChitalishteIskra.Models.Groups
@model IEnumerable<GroupIndexViewModel>

<h2 class="mb-3">Възрастови групи</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Добави група</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Име</th>
            <th>Учител</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.TeacherName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm" style="display:inline">Поправи</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" style="display:inline">
                        <button type="submit" class="btn btn-danger btn-sm">Изтрий</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>


