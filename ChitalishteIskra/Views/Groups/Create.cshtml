@using ChitalishteIskra.Models.Groups
@model GroupCreateViewModel

<h2 class="mb-3">Добави група</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" asp-for="Name" />
    </div>

    <div class="mb-3">
        <label class="form-label">Тeacher</label>
        <select asp-for="TeacherId" asp-items="ViewBag.Teachers" class="form-control" required>
            <option selected disabled>Select teacher</option>
        </select>
    </div>

    <button class="btn btn-primary btn-lg" type="submit">Create</button>
</form>
