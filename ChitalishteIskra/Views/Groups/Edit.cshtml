@using ChitalishteIskra.Models.Groups
@model GroupEditViewModel

<h2 class="mb-3">Поправи група</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" asp-for="Name" />
    </div>

    <div class="mb-3">
        <label class="form-label">Тeacher</label>
        <select asp-for="TeacherId" asp-items="ViewBag.Teachers" class="form-control" required>
            <option selected disabled>Избери учител</option>
        </select>
    </div>

    <button class="btn btn-primary btn-lg" type="submit">Запази</button>
</form>

