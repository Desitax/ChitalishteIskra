@model IEnumerable<ChitalishteIskra.Data.Entities.ContactMessage>

@{
    ViewData["Title"] = "Съобщения";
}

<section class="inner-page py-4">
    <div class="page-header-card mb-4">
        <h1 class="mb-2">Изпратени съобщения</h1>
        <p class="mb-0">Този екран е достъпен само за администратор.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="content-card">
        @if (!Model.Any())
        {
            <p class="mb-0">Няма изпратени съобщения.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Статус</th>
                            <th>Име</th>
                            <th>Email</th>
                            <th>Дата</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var message in Model)
                        {
                            <tr>
                                <td>
                                    @if (message.IsRead)
                                    {
                                        <span class="badge bg-success">Прочетено</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Непрочетено</span>
                                    }
                                </td>
                                <td>@message.Name</td>
                                <td>@message.Email</td>
                                <td>@message.SentOn.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <a asp-controller="Contact"
                                       asp-action="Details"
                                       asp-route-id="@message.Id"
                                       class="btn btn-sm btn-primary">
                                        Преглед
                                    </a>

                                    <form asp-controller="Contact"
                                          asp-action="Delete"
                                          asp-route-id="@message.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Сигурни ли сте, че искате да изтриете това съобщение?');">
                                            Изтрий
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
