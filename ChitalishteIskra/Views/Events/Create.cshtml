@using ChitalishteIskra.Models.Events
@model EventCreateViewModel

@{
    ViewData["Title"] = "Добави събитие";
}

<div class="event-form-page">
    <div class="event-form-card shadow-lg">
        <div class="event-form-header">
            <span class="event-form-kicker">Ново събитие</span>
            <h2>Добави събитие</h2>
            <p>Попълни информацията, която ще се вижда в публичната страница.</p>
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data" class="row g-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-12">
                <label asp-for="Name" class="form-label">Заглавие</label>
                <input class="form-control form-control-lg" asp-for="Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Date" class="form-label">Дата</label>
                <input class="form-control" type="date" asp-for="Date" min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="StartTime" class="form-label">Начало</label>
                <input class="form-control" type="time" asp-for="StartTime" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="EndTime" class="form-label">Край</label>
                <input class="form-control" type="time" asp-for="EndTime" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Location" class="form-label">Място</label>
                <input class="form-control" asp-for="Location" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label">Описание</label>
                <textarea class="form-control" asp-for="Description" rows="6" placeholder="Опиши какво представлява събитието..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="ImageFile" class="form-label">Снимка</label>
                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" id="eventImageInput" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>

                <div class="image-preview-box mt-3" id="imagePreviewBox" style="display:none;">
                    <img id="imagePreview" class="img-fluid rounded" alt="Преглед на снимката" />
                </div>
            </div>

            <div class="col-12 d-flex gap-3 flex-wrap">
                <button class="btn btn-danger btn-lg px-4" type="submit">Създай</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">Назад</a>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <style>
        .event-form-page {
            padding: 2rem 0 4rem;
        }

        .event-form-card {
            max-width: 900px;
            margin: 0 auto;
            background: #fff;
            border-radius: 24px;
            padding: 2rem;
            border: 1px solid rgba(160, 20, 40, 0.08);
        }

        .event-form-header {
            margin-bottom: 1.5rem;
        }

            .event-form-header h2 {
                color: #991b1b;
                font-weight: 700;
                margin-bottom: .5rem;
            }

        .event-form-kicker {
            display: inline-block;
            background: rgba(153, 27, 27, 0.1);
            color: #991b1b;
            border-radius: 999px;
            padding: .35rem .8rem;
            font-size: .9rem;
            font-weight: 700;
            margin-bottom: .75rem;
        }

        .event-form-card .form-control {
            border-radius: 14px;
            padding: .85rem 1rem;
        }

        .event-form-card textarea.form-control {
            resize: vertical;
        }

        .image-preview-box {
            max-width: 420px;
            padding: .75rem;
            border: 1px solid rgba(148, 163, 184, 0.25);
            border-radius: 16px;
            background: #fffaf9;
        }

            .image-preview-box img {
                max-height: 260px;
                object-fit: cover;
            }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const input = document.getElementById('eventImageInput');
        const preview = document.getElementById('imagePreview');
        const box = document.getElementById('imagePreviewBox');

        if (input) {
            input.addEventListener('change', function () {
                const file = this.files && this.files[0];
                if (!file) {
                    box.style.display = 'none';
                    preview.src = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    box.style.display = 'block';
                };
                reader.readAsDataURL(file);
            });
        }
    </script>
}