@using ChitalishteIskra.Models.Events
@model EventEditViewModel

<h2 class="mb-3">Поправи събитие</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Име</label>
        <input class="form-control" asp-for="Name" />
    </div>

    <div class="mb-3">
        <label class="form-label">Дата</label>
        <input class="form-control" type="date" asp-for="Date"
               min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
    </div>

    <div class="mb-3">
        <label class="form-label">Начало</label>
        <input class="form-control" type="time" asp-for="StartTime" />
    </div>

    <div class="mb-3">
        <label class="form-label">Край</label>
        <input class="form-control" type="time" asp-for="EndTime" />
    </div>

    <div class="mb-3">
        <label class="form-label">Местоположение</label>
        <input class="form-control" asp-for="Location" />
    </div>

    <button class="btn btn-primary btn-lg" type="submit">Запази промените</button>
</form>