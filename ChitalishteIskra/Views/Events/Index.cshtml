@using ChitalishteIskra.Models.Events
@model IEnumerable<EventIndexViewModel>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning">
        @TempData["WarningMessage"]
    </div>
}

<h2 class="mb-3">Събития</h2>

@if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
{
    <a asp-action="Create" class="btn btn-primary mb-3">Добави събитие</a>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Име</th>
            <th>Дата</th>
            <th>Начало</th>
            <th>Край</th>
            <th>Местоположение</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)

        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Date</td>
                <td>@item.StartTime</td>
                <td>@item.EndTime</td>
                <td>@item.Location</td>

                @if (User.IsInRole("Admin"))

                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Поправи</a>

                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">Изтрий</button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

