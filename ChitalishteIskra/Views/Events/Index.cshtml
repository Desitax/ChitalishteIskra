@model IEnumerable<ChitalishteIskra.Data.Entities.Event>

<h2 class="mb-3">Events</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Add event</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Date</th>
            <th>Start time</th>
            <th>End time</th>
            <th>Location</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Date</td>
                <td>@item.StartTime</td>
                <td>@item.EndTime</td>
                <td>@item.Location</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm" style="display:inline">Edit</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" style="display:inline">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

