@using ChitalishteIskra.Models.Events
@model EventIndexViewModel

@using System.Globalization

@{
    ViewData["Title"] = Model.Name;
}

<div class="event-details-page">
    <a asp-action="Index" class="event-back-link">← Към всички събития</a>

    <article class="event-details-card shadow-lg">
        <div class="event-details-media">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" class="event-details-image" />
            }
            else
            {
                <div class="event-details-image event-details-placeholder">
                    <span>@Model.Name</span>
                </div>
            }
        </div>

        <div class="event-details-content">
            <span class="event-details-badge">@Model.Date.ToString("dd MMMM", new CultureInfo("bg-BG"))</span>
            <h1>@Model.Name</h1>

            <div class="event-meta-grid">
                <div class="event-meta-item">
                    <span>Час</span>
                    <strong>@Model.StartTime.ToString("HH\\:mm") - @Model.EndTime.ToString("HH\\:mm") ч.</strong>
                </div>
                <div class="event-meta-item">
                    <span>Място</span>
                    <strong>@Model.Location</strong>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="event-description-box">
                    <h3>За събитието</h3>
                    <p>@Model.Description</p>
                </div>
            }

            @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
            {
                <div class="d-flex gap-2 flex-wrap mt-3">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редактирай</a>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger"
                                onclick="return confirm('Сигурен ли си, че искаш да изтриеш това събитие?')">
                            Изтрий
                        </button>
                    </form>
                </div>
            }
        </div>
    </article>
</div>

@section Styles {
    <style>
        .event-details-page {
            padding: 2rem 0 4rem;
        }

        .event-back-link {
            display: inline-block;
            margin-bottom: 1rem;
            color: #991b1b;
            text-decoration: none;
            font-weight: 700;
        }

        .event-details-card {
            background: #fff;
            border-radius: 28px;
            overflow: hidden;
            border: 1px solid rgba(15, 23, 42, 0.08);
            display: grid;
            grid-template-columns: 1.1fr 1fr;
        }

        .event-details-image {
            width: 100%;
            height: 100%;
            min-height: 420px;
            object-fit: cover;
            display: block;
        }

        .event-details-placeholder {
            min-height: 420px;
            background: linear-gradient(135deg, #fecaca, #fca5a5, #f87171);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            text-align: center;
            font-size: 2rem;
            font-weight: 800;
            color: #7f1d1d;
        }

        .event-details-content {
            padding: 2rem;
        }

        .event-details-badge {
            display: inline-block;
            background: rgba(185, 28, 28, 0.1);
            color: #991b1b;
            padding: .45rem .85rem;
            border-radius: 999px;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .event-details-content h1 {
            color: #991b1b;
            font-weight: 800;
            margin-bottom: 1.25rem;
        }

        .event-meta-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .event-meta-item {
            background: #f8fafc;
            border-radius: 18px;
            padding: 1rem;
            border: 1px solid rgba(148, 163, 184, 0.18);
        }

            .event-meta-item span {
                display: block;
                color: #64748b;
                margin-bottom: .35rem;
            }

        .event-description-box {
            background: linear-gradient(180deg, #fff 0%, #fff7f7 100%);
            border: 1px solid rgba(185, 28, 28, 0.08);
            border-radius: 20px;
            padding: 1.25rem;
        }

            .event-description-box h3 {
                color: #991b1b;
                font-size: 1.2rem;
                margin-bottom: .75rem;
            }

            .event-description-box p {
                margin: 0;
                color: #334155;
                line-height: 1.8;
                white-space: pre-line;
            }

        @@media (max-width: 992px) {
            .event-details-card {
                grid-template-columns: 1fr;
            }

            .event-details-image,
            .event-details-placeholder {
                min-height: 300px;
            }

            .event-meta-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}