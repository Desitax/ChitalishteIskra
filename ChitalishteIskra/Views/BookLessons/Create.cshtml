@using ChitalishteIskra.Models.BookLessons
@model BookLessonCreateViewModel

<h2 class="mb-3">Запази час</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Урок</label>
        <select asp-for="LessonId" asp-items="Model.Lessons" class="form-control">
            <option selected disabled value="">Избери урок</option>
        </select>
        <span asp-validation-for="LessonId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Свободен час</label>
        <select asp-for="TeacherAvailabilityId" asp-items="Model.AvailableSlots" class="form-control">
            <option selected disabled value="">Избери свободен час</option>
        </select>
        <span asp-validation-for="TeacherAvailabilityId" class="text-danger"></span>
    </div>

    <button class="btn btn-primary" type="submit">Запази</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}



