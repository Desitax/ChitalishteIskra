    @using ChitalishteIskra.Models.BookLessons
@model BookLessonEditViewModel

<h2 class="mb-3">Edit booking</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Date</label>
        <input class="form-control" type="date" asp-for="Date"
               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
    </div>

    <div class="mb-3">
        <label class="form-label">Start time</label>
        <input class="form-control" type="time" asp-for="StartTime" />
    </div>

    <div class="mb-3">
        <label class="form-label">End time</label>
        <input class="form-control" type="time" asp-for="EndTime" />
    </div>

    <div class="mb-3">
        <label class="form-label">Teacher</label>
        <select asp-for="TeacherId" asp-items="ViewBag.Teachers" class="form-control" required>
            <option selected disabled value="">Select Teacher</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Lesson</label>
        <select asp-for="LessonId" asp-items="ViewBag.Lessons" class="form-control" required>
            <option selected disabled value="">Select Lesson</option>
        </select>
    </div>

    <button class="btn btn-primary btn-lg" type="submit">Save</button>
</form>


