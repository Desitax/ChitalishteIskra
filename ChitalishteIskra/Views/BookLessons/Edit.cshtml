@using ChitalishteIskra.Models.BookLessons
@model BookLessonEditViewModel

<h2 class="mb-3">Поправи часа</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Date" class="form-label">Дата</label>
        <input class="form-control" type="date" asp-for="Date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartTime" class="form-label">Начало</label>
        <input class="form-control" type="time" asp-for="StartTime" />
        <span asp-validation-for="StartTime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndTime" class="form-label">Край</label>
        <input class="form-control" type="time" asp-for="EndTime" />
        <span asp-validation-for="EndTime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="GroupId" class="form-label">Възрастова група</label>
        <select asp-for="GroupId" asp-items="Model.Groups" class="form-control">
            <option value="">Без възрастова група</option>
        </select>
        <span asp-validation-for="GroupId" class="text-danger"></span>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="mb-3">
            <label asp-for="TeacherId" class="form-label">Учител</label>
            <select asp-for="TeacherId" asp-items="Model.Teachers" class="form-control" required>
                <option value="">Избери учител</option>
            </select>
            <span asp-validation-for="TeacherId" class="text-danger"></span>
        </div>
    }
    else
    {
        <input type="hidden" asp-for="TeacherId" />
        <div class="mb-3">
            <label class="form-label">Учител</label>
            <input class="form-control" value="@ViewBag.SelectedTeacherName" readonly />
        </div>
    }

    <div class="mb-3">
        <label asp-for="LessonId" class="form-label">Урок</label>
        <select asp-for="LessonId" asp-items="Model.Lessons" class="form-control" required>
            <option value="">Избери урок</option>
        </select>
        <span asp-validation-for="LessonId" class="text-danger"></span>
    </div>

    <button class="btn btn-primary" type="submit">Запази</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}