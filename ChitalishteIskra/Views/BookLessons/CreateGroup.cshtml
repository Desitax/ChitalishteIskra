@using ChitalishteIskra.Models.BookLessons
@model BookLessonCreateGroupViewModel

<h2 class="mb-3">Добави групов урок</h2>

<form asp-action="CreateGroup" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Date" class="form-label">Дата</label>
        <input asp-for="Date"
               type="date"
               class="form-control"
               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartTime" class="form-label">Начало</label>
        <input asp-for="StartTime" type="time" class="form-control" />
        <span asp-validation-for="StartTime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndTime" class="form-label">Край</label>
        <input asp-for="EndTime" type="time" class="form-control" />
        <span asp-validation-for="EndTime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LessonId" class="form-label">Урок</label>
        <select asp-for="LessonId" asp-items="Model.Lessons" class="form-control">
            <option value="">Избери групов урок</option>
        </select>
        <span asp-validation-for="LessonId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="GroupId" class="form-label">Група</label>
        <select asp-for="GroupId" asp-items="Model.Groups" class="form-control">
            <option value="">Избери възрастова група</option>
        </select>
        <span asp-validation-for="GroupId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Изпрати покана на деца</label>

        <div class="student-list form-control p-0" style="max-height:260px; overflow-y:auto;">
            @if (Model.Students != null && Model.Students.Any())
            {
                foreach (var student in Model.Students)
                {
                    bool isChecked = Model.SelectedStudentIds.Any(x => x.ToString() == student.Value);

                    <label class="student-row d-flex align-items-center m-0 px-3 py-2 border-bottom" style="cursor:pointer;">
                        <input type="checkbox"
                               name="SelectedStudentIds"
                               value="@student.Value"
                               class="form-check-input me-2 student-checkbox"
                        @(isChecked ? "checked" : null) />
                        <span>@student.Text</span>
                    </label>
                }
            }
            else
            {
                <div class="px-3 py-2 text-muted">Няма налични ученици.</div>
            }
        </div>

        <span asp-validation-for="SelectedStudentIds" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Създай</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const rows = document.querySelectorAll(".student-row");

            rows.forEach(row => {
                row.addEventListener("click", function (e) {
                    if (e.target.tagName.toLowerCase() === "input") {
                        toggleRowStyle(row);
                        return;
                    }

                    const checkbox = row.querySelector(".student-checkbox");
                    checkbox.checked = !checkbox.checked;
                    toggleRowStyle(row);
                });

                const checkbox = row.querySelector(".student-checkbox");
                if (checkbox) {
                    checkbox.addEventListener("change", function () {
                        toggleRowStyle(row);
                    });

                    toggleRowStyle(row);
                }
            });

            function toggleRowStyle(row) {
                const checkbox = row.querySelector(".student-checkbox");

                if (checkbox && checkbox.checked) {
                    row.classList.add("bg-light");
                    row.style.fontWeight = "600";
                } else {
                    row.classList.remove("bg-light");
                    row.style.fontWeight = "400";
                }
            }
        });
    </script>
}