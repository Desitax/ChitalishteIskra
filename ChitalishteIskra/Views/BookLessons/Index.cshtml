@using ChitalishteIskra.Models.BookLessons
@model IEnumerable<BookLessonIndexViewModel>

<h2 class="mb-3">Запазени уроци</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-bordered table-striped align-middle">
    <thead>
        <tr>
            <th>Дата</th>
            <th>Начало</th>
            <th>Край</th>

            @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
            {
                <th>Възрастова група</th>
                <th>Приели поканата</th>
            }

            <th>Учител</th>
            <th>Урок</th>

            @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
            {
                <th>Действия</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var booking in Model)
        {
            <tr>
                <td>@booking.Date</td>
                <td>@booking.StartTime.ToString("HH:mm")</td>
                <td>@booking.EndTime.ToString("HH:mm")</td>

                @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                {
                    <td>@booking.GroupName</td>
                    <td>@booking.AcceptedStudents</td>
                }

                <td>@booking.TeacherName</td>
                <td>@booking.LessonName</td>

                @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                {
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@booking.Id"
                           class="btn btn-warning btn-sm me-1">
                            Поправи
                        </a>

                        <form asp-action="Delete" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@booking.Id" />
                            <button type="submit"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Сигурен ли си, че искаш да изтриеш този час?');">
                                Изтрий
                            </button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>