@using ChitalishteIskra.Models.BookLessons
@model IEnumerable<BookLessonIndexViewModel>

<h2 class="mb-3">Bookings</h2>

@if (User.IsInRole("Student") || User.IsInRole("Parent"))

{
    <a asp-action="Create" class="btn btn-primary mb-3">Запази час</a>
}
@if (User.IsInRole("Admin") || User.IsInRole("Teacher"))

{
    <a asp-action="CreateGroup" class="btn btn-primary mb-3">Добави групов урок</a>
}
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Date</th>
            <th>Start time</th>
            <th>End time</th>
            <th>Teacher</th>
            <th>Lesson</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var booking in Model)

        {
            <tr>
                <td>@booking.Date</td>
                <td>@booking.StartTime</td>
                <td>@booking.EndTime</td>
                <td>@booking.TeacherName</td>
                <td>@booking.LessonName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@booking.Id" method="post" class="btn btn-warning btn-sm" style="display:inline">Edit</a>

                    <form asp-action="Delete" asp-route-id="@booking.Id" method="post" style="display:inline">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

