@model ChitalishteIskra.Models.RegisterViewModel

@{
    ViewData["Title"] = "Регистрация на ученик";
}

<h1 class="text-center">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6 offset-md-3">
        <form id="registerForm" method="post">
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="text-center mb-3">
                <label asp-for="UserName">Потребителско име</label>
                <input class="form-control" autocomplete="username" aria-required="true" asp-for="UserName" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="text-center mb-3">
                <label asp-for="Email">Имейл</label>
                <input class="form-control" autocomplete="email" aria-required="true" asp-for="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="text-center mb-3">
                <label asp-for="Password">Парола</label>
                <input class="form-control" type="password" autocomplete="new-password" aria-required="true" asp-for="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="text-center mb-3">
                <label asp-for="ConfirmPassword">Потвърди парола</label>
                <input class="form-control" type="password" autocomplete="new-password" aria-required="true" asp-for="ConfirmPassword" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <hr />

            <div class="mb-3">
                <label asp-for="FirstName">Име</label>
                <input class="form-control" asp-for="FirstName" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName">Фамилия</label>
                <input class="form-control" asp-for="LastName" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Age">Години</label>
                <input class="form-control" asp-for="Age" type="number" />
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <div class="text-center mt-3">
                <button id="registerSubmit" type="submit" class="btn btn-primary">Регистрирай се</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}