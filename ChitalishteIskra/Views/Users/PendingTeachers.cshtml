@using ChitalishteIskra.Data.Entities
@model IEnumerable<User>

@* <h2>Pending Teacher Requests</h2> *@

@{
    ViewData["Title"] = "Регистрация на учител";
}

<h2>Регистрация на учител</h2>

@if (!Model.Any())
{
    <p>Няма чакащи заявки за учители.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Име</th>
                <th>Имейл</th>
                <th>Години</th>
                <th>Заявен</th>
                <th>Приет</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var teacher in Model)
            {
                <tr>
                    <td>@teacher.FirstName @teacher.LastName</td>
                    <td>@teacher.Email</td>
                    <td>@teacher.Age</td>
                    <td>@teacher.IsTeacherRequest</td>
                    <td>@teacher.IsApprovedTeacher</td>
                    <td>
                        <form asp-action="ApproveTeacher" asp-route-id="@teacher.Id" method="post">
                            <button type="submit" class="btn btn-success btn-sm">Одобряване</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

