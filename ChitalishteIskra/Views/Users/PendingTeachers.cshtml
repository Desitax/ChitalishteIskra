@using ChitalishteIskra.Data.Entities
@model IEnumerable<User>

@{
    ViewData["Title"] = "Заявки за учители";
}

<h2>Заявки за учители</h2>

@if (!Model.Any())
{
    <p>Няма чакащи заявки за учители.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Име</th>
                <th>Имейл</th>
                <th>Години</th>
                <th>Заявка</th>
                <th>Одобрен</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var teacher in Model)
            {
                <tr>
                    <td>@teacher.FirstName @teacher.LastName</td>
                    <td>@teacher.Email</td>
                    <td>@teacher.Age</td>
                    <td>@(teacher.IsTeacherRequest ? "Да" : "Не")</td>
                    <td>@(teacher.IsApprovedTeacher ? "Да" : "Не")</td>
                    <td class="d-flex gap-2">
                        <form asp-action="ApproveTeacher" asp-route-id="@teacher.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-sm">Одобряване</button>
                        </form>

                        <form asp-action="RemoveTeacherRequest" asp-route-id="@teacher.Id" method="post"
                              onsubmit="return confirm('Сигурни ли сте, че искате да премахнете тази заявка?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">Премахване</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}