@model ChitalishteIskra.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<h1 class="text-center">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6 offset-md-3">
        <form id="registerForm" method="post">
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="text-center mb-3">
                <label asp-for="UserName">Username</label>
                <input class="form-control" autocomplete="username" aria-required="true" asp-for="UserName" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="text-center mb-3">
                <label asp-for="Email">Email</label>
                <input class="form-control" autocomplete="username" aria-required="true" asp-for="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="text-center mb-3">
                <label asp-for="Password">Password</label>
                <input class="form-control" type="password" autocomplete="new-password" aria-required="true" asp-for="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="text-center mb-3">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <input class="form-control" type="password" autocomplete="new-password" aria-required="true" asp-for="ConfirmPassword" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <hr />

            <div id="childInfoSection">
                <h4 class="text-center">Child Info</h4>
                <div class="mb-3">
                    <label asp-for="ChildInfo.FirstName">First Name</label>
                    <input class="form-control" asp-for="ChildInfo.FirstName" />
                    <span asp-validation-for="ChildInfo.FirstName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ChildInfo.LastName">Last Name</label>
                    <input class="form-control" asp-for="ChildInfo.LastName" />
                    <span asp-validation-for="ChildInfo.LastName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ChildInfo.Age">Age</label>
                    <input class="form-control" asp-for="ChildInfo.Age" type="number" />
                    <span asp-validation-for="ChildInfo.Age" class="text-danger"></span>
                </div>
            </div>

            <div id="parentInfoSection" style="display:none;">
                <hr />
                <h4 class="text-center">Parent Info</h4>
                <div class="mb-3">
                    <label asp-for="ParentInfo.FirstName">Parent First Name</label>
                    <input class="form-control" asp-for="ParentInfo.FirstName" />
                    <span asp-validation-for="ParentInfo.FirstName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ParentInfo.LastName">Parent Last Name</label>
                    <input class="form-control" asp-for="ParentInfo.LastName" />
                    <span asp-validation-for="ParentInfo.LastName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ParentInfo.Age">Parent Age</label>
                    <input class="form-control" asp-for="ParentInfo.Age" type="number" />
                    <span asp-validation-for="ParentInfo.Age" class="text-danger"></span>
                </div>
            </div>

            <div class="text-center mb-4">
                <button type="button" class="btn btn-outline-primary me-2" id="singleChildBtn">Register Single Child</button>
                <button type="button" class="btn btn-outline-secondary" id="childWithParentBtn">Register Child with Parent</button>
            </div>

            <div class="text-center mt-3">
                <button id="registerSubmit" type="submit" class="btn btn-primary">Register</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const singleChildBtn = document.getElementById('singleChildBtn');
        const childWithParentBtn = document.getElementById('childWithParentBtn');
        const parentInfoSection = document.getElementById('parentInfoSection');

        singleChildBtn.addEventListener('click', () => {
            parentInfoSection.style.display = 'none';
        });

        childWithParentBtn.addEventListener('click', () => {
            parentInfoSection.style.display = 'block';
        });
    </script>
}
