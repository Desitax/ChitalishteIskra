@using ChitalishteIskra.Models.TeacherAvailabilities
@model TeacherAvailabilitiesCreateViewModel

<h2 class="mb-3">Edit availability</h2>

<form asp-action="Edit" method="post">
    <div class="mb-3">
        <label class="form-label">Teacher</label>
        <input class="form-control" asp-for="TeacherId" />
    </div>

    <div class="mb-3">
        <label class="form-label">Date</label>A
        <input class="form-control" date type="date" asp-for="Date" />
    </div>

    <div class="mb-3">
        <label class="form-label">Start time</label>
        <input class="form-control" type="time" asp-for="StartTime" />
    </div>

    <div class="mb-3">
        <label class="form-label">End time</label>
        <input class="form-control" type="time" asp-for="EndTime" />
    </div>

    <div class="form-group">
        <label class="form-label">Наличен ли е</label><br />

        <div class="form-check form-check-inline">
            @Html.RadioButtonFor(model => model.IsAvailable, true, new { @class = "form-check-input" })
            <label class="form-check-label">Да</label>
        </div>

        <div class="form-check form-check-inline">
            @Html.RadioButtonFor(model => model.IsAvailable, false, new { @class = "form-check-input" })
            <label class="form-check-label">Не</label>
        </div>
    </div>

    <button class="btn btn-primary btn-lg" type="submit">Save</button>
</form>

