@using ChitalishteIskra.Models.TeacherAvailabilities
@model IEnumerable<TeacherAvailabilityIndexViewModel>

<h2 class="mb-3">Работно време на учител</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Добави работно време</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Учител</th>
            <th>Ден</th>
            <th>Начало</th>
            <th>Край</th>
            <th>Наличен ли е</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TeacherName</td>
                <td>@item.DayOfWeek</td>
                <td>@item.StartTime</td>
                <td>@item.EndTime</td>
                <td>@(item.IsAvailable ? "Да" : "Не")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm" style="display:inline">Поправи</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm">Изтрий</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>