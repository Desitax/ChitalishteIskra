@model ChitalishteIskra.Models.TeacherLessons.TeacherLessonCreateViewModel

<h2>Назначи предмет на учител</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="TeacherId" class="form-label">Учител</label>
        <select asp-for="TeacherId" asp-items="Model.Teachers" class="form-control">
            <option value="">Избери учител</option>
        </select>
        <span asp-validation-for="TeacherId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LessonId" class="form-label">Предмет</label>
        <select asp-for="LessonId" asp-items="Model.Lessons" class="form-control">
            <option value="">Избери предмет</option>
        </select>
        <span asp-validation-for="LessonId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Добави</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}