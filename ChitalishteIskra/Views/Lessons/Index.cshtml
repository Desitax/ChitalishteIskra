@using ChitalishteIskra.Models.Lessons
@model IEnumerable<LessonIndexViewModel>

<h2 class="mb-3">Уроци</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Добави урок</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Име</th>
            <th>Тип урок</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lesson in Model)
        {
            <tr>
                <td>@lesson.Name</td>
                <td>@lesson.TypeName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@lesson.Id" class="btn btn-warning btn-sm" method="Post" style="display:inline">Поправи</a>
                    <form asp-action="Delete" asp-route-id="@lesson.Id" style="display:inline">
                        <button type="submit" class="btn btn-danger btn-sm">Изтрий</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
