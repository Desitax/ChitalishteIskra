@using ChitalishteIskra.Models.Lessons
@model IEnumerable<LessonIndexViewModel>

@{
    bool isAdmin = User.IsInRole("Admin");
    bool isTeacher = User.IsInRole("Teacher");
}

<h2>Предмети</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (isAdmin || isTeacher)
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Добави предмет</a>
    </p>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Име</th>

            @if (isTeacher)
            {
                <th>Тип</th>
            }

            @if (isAdmin)
            {
                <th>Действия</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var lesson in Model)
        {
            <tr>
                <td>@lesson.Name</td>

                @if (isTeacher)
                {
                    <td>
                        @(lesson.TypeName == "Individual" ? "Индивидуален" :
                            lesson.TypeName == "Group" ? "Групов" :
                            lesson.TypeName)
                    </td>
                }

                @if (isAdmin)
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@lesson.Id" class="btn btn-warning btn-sm">
                            Редактирай
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@lesson.Id"
                              method="post"
                              style="display:inline;">
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Сигурен ли си, че искаш да изтриеш този предмет?')">
                                Изтрий
                            </button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>