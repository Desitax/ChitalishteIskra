@{
    ViewData["Title"] = "Сцена";
}

<section class="stage-page section">
    <div class="container">
        <h1 class="stage-title">Технически показатели</h1>

        <h2 class="stage-subtitle">Снимки</h2>
        <div class="stage-gallery">
            <img src="https://res.cloudinary.com/dxloy3tkq/image/upload/v1776549318/zjixbudqo19rq3czlgmq.jpg" alt="Сцена">
            <img src="https://res.cloudinary.com/dxloy3tkq/image/upload/v1776549342/rxqlzcfuvdum0uebonij.jpg" alt="Зала">
        </div>

        <div class="stage-divider"></div>

        <h2 class="stage-subtitle">Сцена</h2>
        <ul class="stage-list">
            <li>Отвор – 8,5 метра</li>
            <li>Височина – 5,5 метра</li>
            <li>Дълбочина – 12 метра</li>
            <li>Аванс сцена – оркестрина (9,00 м х 3,00 м)</li>
            <li>Механични чиги (ръчни) – 16 бр. (през 30 см)</li>
        </ul>

        <h2 class="stage-subtitle">Осветление</h2>
        <ul class="stage-list">
            <li>Прожектори (статични) – 30 бр.</li>
            <li>Подвижни прожектори – 4 бр.</li>
            <li>Подови контакти – 4 бр.</li>
        </ul>

        <h2 class="stage-subtitle">Зала</h2>
        <ul class="stage-list">
            <li>Общ брой места – 443</li>
            <li>Балкон – 125</li>
            <li>Салон – 318</li>
        </ul>

        <h2 class="stage-subtitle">Осветителна и озвучителна уредба</h2>

        <h3 class="stage-small-title">Озвучителна уредба</h3>
        <ul class="stage-list">
            <li>Пулт</li>
            <li>Усилвател</li>
            <li>Монитори – 2 бр.</li>
            <li>Тонколони – 2 бр.</li>
        </ul>

        <h2 class="stage-subtitle">Схеми</h2>

        <h3 class="stage-small-title">Схема на сцената</h3>
        <div class="stage-scheme">
            <img src="https://res.cloudinary.com/dxloy3tkq/image/upload/v1776549847/k7py2emri60byirzzbiu.jpg" alt="Схема на сцената">
        </div>

        <h3 class="stage-small-title">Схема на залата</h3>
        <div class="stage-scheme">
            <img src="https://res.cloudinary.com/dxloy3tkq/image/upload/v1776549863/rm3swf5gvhuzdu0uohi9.jpg" alt="Схема на залата">
        </div>
    </div>
</section>