@{
    ViewData["Title"] = "Школа по изкуствата „Емануил Манолов“";

    var heroImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776090164/cohsvmrscntlvmrrqspj.jpg";
    var contentImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776090198/mfgb4hhahahywvqnq70j.jpg";
}

<div class="container py-5" style="background-color: #fff9e8; border-radius: 28px;">

    <!-- HERO -->
    <div class="overflow-hidden mb-5 text-white d-flex align-items-center"
         style="min-height: 360px;
                border-radius: 30px;
                box-shadow: 0 12px 30px rgba(0,0,0,0.12);
                background: linear-gradient(rgba(0,0,0,.65), rgba(0,0,0,.45)),
                url('@heroImage') center/cover no-repeat;">

        <div class="p-5">
            <p class="text-uppercase mb-2" style="letter-spacing: 2px;">Народно читалище „Искра-1860”</p>
            <h1 class="fw-bold mb-3" style="font-size: 2.5rem;">Школа по изкуствата „Емануил Манолов“</h1>
            <p class="mb-0 col-lg-8 fs-5">
                Една от водещите музикални и артистични школи в България с дългогодишна традиция.
            </p>
        </div>
    </div>

    <!-- ЗА ШКОЛАТА -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 24px; overflow: hidden;">
        <div class="card-body p-4 p-lg-5">
            <div class="row align-items-center gx-5">

                <!-- СНИМКА -->
                <div class="col-lg-5 mb-4 mb-lg-0">
                    <img src="@contentImage"
                         class="img-fluid shadow w-100"
                         style="max-width: 520px; margin: 0 auto; display: block; border-radius: 24px;"
                         alt="Школа Емануил Манолов" />
                </div>

                <!-- ТЕКСТ -->
                <div class="col-lg-7">
                    <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">За школата</h2>
                    <p style="line-height: 1.8; color: #4b5563;">
                        Школа по изкуствата „Емануил Манолов“ е създадена през 1956 г. и носи името
                        на първия български композитор.
                    </p>
                    <p style="line-height: 1.8; color: #4b5563;">
                        От създаването си досега, школата се утвърждава като водеща институция
                        в областта на музикалното и артистичното образование.
                    </p>
                    <p class="mb-0" style="line-height: 1.8; color: #4b5563;">
                        В школата се обучават над 150 деца и младежи, които печелят множество
                        награди от национални и международни конкурси.
                    </p>
                </div>

            </div>
        </div>
    </div>

    <!-- ОБУЧЕНИЕ -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 24px; overflow: hidden;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">Обучение</h2>

            <ul class="list-group list-group-flush" style="border-radius: 18px; overflow: hidden;">
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">Пиано</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">Цигулка</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">Синтезатор</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">Акордеон</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">Китара</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">Солфеж</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">Вокално пеене</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">Английски език</li>
            </ul>

            <p class="mt-4 mb-0" style="line-height: 1.8; color: #4b5563;">
                Школата редовно се нарежда сред най-добрите музикални школи в страната
                и многократно е печелила приз за „Най-добре представена музикална школа в България“.
            </p>
        </div>
    </div>

    <!-- ПРЕПОДАВАТЕЛИ -->
    <div class="card border-0 shadow-sm" style="border-radius: 24px; overflow: hidden;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">Преподаватели</h2>

            <ul class="list-group list-group-flush" style="border-radius: 18px; overflow: hidden;">
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;"><strong>Пиано:</strong> Елена Юлиянова, Валя Костова, Йорданка Русинова</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;"><strong>Китара:</strong> Ивайло Петков</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;"><strong>Синтезатор:</strong> Валя Костова</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;"><strong>Акордеон:</strong> Йорданка Русинова</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;"><strong>Цигулка:</strong> Любена Койчева-Тянова</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;"><strong>Солфеж:</strong> Марияна Георгиева</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;"><strong>Английски език:</strong> Йорданка Русинова</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;"><strong>Вокално пеене:</strong> Стефка Денева</li>
            </ul>

        </div>
    </div>

</div>