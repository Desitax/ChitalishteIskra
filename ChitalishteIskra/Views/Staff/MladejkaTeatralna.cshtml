@{
    ViewData["Title"] = "Младежка театрална студия";

    var heroImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776089885/dwtjykstphr0jogvbao0.jpg";
    var contentImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776089926/becrqlruenapey0cmpey.jpg";
}

<div class="container py-5" style="background-color: #fff9e8; border-radius: 28px;">

    <!-- HERO -->
    <div class="overflow-hidden mb-5 text-white d-flex align-items-center"
         style="min-height: 360px;
                border-radius: 30px;
                box-shadow: 0 12px 30px rgba(0,0,0,0.12);
                background: linear-gradient(rgba(0,0,0,.65), rgba(0,0,0,.45)),
                url('@heroImage') center/cover no-repeat;">

        <div class="p-5">
            <p class="text-uppercase mb-2" style="letter-spacing: 2px;">Народно читалище „Искра-1860”</p>
            <h1 class="fw-bold mb-3" style="font-size: 2.5rem;">Младежка театрална студия</h1>
            <p class="mb-0 col-lg-8 fs-5">
                Дългогодишна театрална традиция, насочена към развитие на млади таланти.
            </p>
        </div>
    </div>

    <!-- ЗА СТУДИЯТА -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 24px; overflow: hidden;">
        <div class="card-body p-4 p-lg-5">
            <div class="row align-items-center gx-5">

                <!-- СНИМКА -->
                <div class="col-lg-5 mb-4 mb-lg-0">
                    <img src="@contentImage"
                         class="img-fluid shadow w-100"
                         style="max-width: 520px; margin: 0 auto; display: block; border-radius: 24px;"
                         alt="Младежка театрална студия" />
                </div>

                <!-- ТЕКСТ -->
                <div class="col-lg-7">
                    <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">За студията</h2>
                    <p style="line-height: 1.8; color: #4b5563;">
                        Младежкото театрално творчество в Народно читалище „Искра-1860“ води началото си
                        от 1976 година със създаването на Драматичен театър за деца и юноши.
                    </p>
                    <p style="line-height: 1.8; color: #4b5563;">
                        През годините формацията преминава през различни етапи на развитие и носи
                        различни наименования, като запазва своята основна мисия – работа с млади хора
                        чрез театралното изкуство.
                    </p>
                    <p class="mb-0" style="line-height: 1.8; color: #4b5563;">
                        Студията е носител на множество награди от национални и международни театрални фестивали.
                    </p>
                </div>

            </div>
        </div>
    </div>

    <!-- РЕПЕРТОАР -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 24px;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">Репертоар</h2>
            <p class="mb-0" style="line-height: 1.8; color: #4b5563;">
                В репертоара са включени спектакли като „Ние врабчетата“, „Анатомия на паяжината“,
                „Годеж“, „Боли ме…“, „Пясъчен пъзел“, „Откриването на Америка“,
                както и пантомимният спектакъл „Сътворение“.
            </p>
        </div>
    </div>

    <!-- ПОСТИЖЕНИЯ -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 24px;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">Постижения</h2>
            <p class="mb-0" style="line-height: 1.8; color: #4b5563;">
                През годините редица възпитаници на студията поемат по професионалния път на театъра
                и днес са част от трупите на различни театри в България – най-високото признание
                за дългогодишната педагогическа и творческа работа на формацията.
            </p>
        </div>
    </div>

    <!-- НАПРАВЛЕНИЯ -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 24px; overflow: hidden;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">Творчески направления</h2>

            <ul class="list-group list-group-flush" style="border-radius: 18px; overflow: hidden;">
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">Школа по художествено слово</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">Студио „Пантомима“</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">Формация „Буфо“</li>
            </ul>

        </div>
    </div>

    <!-- РЪКОВОДИТЕЛ -->
    <div class="card border-0 shadow-sm" style="border-radius: 24px;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">Художествен ръководител</h2>
            <p class="mb-0" style="line-height: 1.8; color: #4b5563;">
                <strong>Петър Петров</strong>
            </p>
        </div>
    </div>

</div>