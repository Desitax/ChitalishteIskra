@{
    ViewData["Title"] = "Ансамбъл за народни песни и танци „Искра“";

    var heroImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776078905/jiotxlbkanbbyp7o9ses.jpg";
    var contentImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776078850/oc3n0jwjzpfqczyvbnx8.jpg";
}

<div class="container py-5">

    <!-- HERO -->
    <div class="rounded-4 overflow-hidden mb-5 text-white d-flex align-items-center"
         style="min-height: 360px;
                background: linear-gradient(rgba(0,0,0,.65), rgba(0,0,0,.45)),
                url('@heroImage') center/cover no-repeat;">

        <div class="p-5">
            <p class="text-uppercase mb-2" style="letter-spacing: 2px;">Народно читалище „Искра-1860”</p>
            <h1 class="fw-bold mb-3">Ансамбъл за народни песни и танци „Искра”</h1>
            <p class="mb-0 col-lg-8 fs-5">
                Една от утвърдените формации в културния живот на Казанлък с над 50-годишна история.
            </p>
        </div>
    </div>

    <!-- ЗА АНСАМБЪЛА -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-lg-5">
            <div class="row align-items-center">

                <!-- ТЕКСТ -->
                <div class="col-lg-7">
                    <h2 class="mb-4">За ансамбъла</h2>
                    <p>
                        Ансамбълът за народни песни и танци „Искра“ е създаден преди повече от 50 години
                        и е една от утвърдените формации в културния живот на Казанлък.
                    </p>
                    <p>
                        Той функционира към Народно читалище „Искра-1860“ и обединява три танцови състава –
                        Детски, Средношколски и Представителен, а също така Народен хор и Битов оркестър.
                    </p>
                    <p class="mb-0">
                        В дейността на ансамбъла участват над 120 деца, младежи и девойки.
                    </p>
                </div>

                <!-- СНИМКА -->
                <div class="col-lg-5 text-center mt-4 mt-lg-0">
                    <img src="@contentImage"
                         class="img-fluid rounded-4 shadow-sm"
                         style="max-width: 105%; height: auto;"
                         alt="Ансамбъл Искра" />
                </div>

            </div>
        </div>
    </div>

    <!-- РЕПЕРТОАР -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4">Репертоар</h2>
            <p>
                Репертоарът на ансамбъла обхваща всички основни етнографски области на България –
                Пиринска, Тракийска, Шопска, Добруджанска и Северняшка.
            </p>
            <p>
                Народният хор и оркестърът изпълняват както автентични фолклорни песни,
                така и обработени произведения.
            </p>
            <p class="mb-0">
                Съчетанието от характерна хореография, автентична музика и традиционни костюми
                поднасят на сетивата цялото богатство и многообразие на българския фолклор.
            </p>
        </div>
    </div>

    <!-- НАГРАДИ -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4">Награди и признание</h2>
            <p>
                Представителният танцов състав на Ансамбъл „Искра“ е носител на множество престижни награди
                от национални и международни конкурси и фестивали.
            </p>
            <p>
                През годините ансамбълът осъществява концертни турнета в редица държави, сред които
                Унгария, Полша, Франция, Русия, Китай, Канада, Гърция, Испания, Италия и Турция.
            </p>
            <p class="mb-0">
                Ансамбъл за народни песни и танци „Искра“ притежава званието
                <strong>„Представителен ансамбъл“ на ЦИОФФ – ЮНЕСКО за България.</strong>
            </p>
        </div>
    </div>

    <!-- ЕКИП -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4">Художествен екип</h2>

            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <strong>Главен художествен ръководител:</strong> Цветан Цочев
                </li>
                <li class="list-group-item">
                    <strong>Хореографи:</strong> Таня Георгиева, Динко Дяков
                </li>
                <li class="list-group-item">
                    <strong>Диригент на народния хор:</strong> Соня Владева
                </li>
                <li class="list-group-item">
                    <strong>Корепетитори:</strong> Алдин Ковачев, Руси Андролов
                </li>
            </ul>
        </div>
    </div>

</div>