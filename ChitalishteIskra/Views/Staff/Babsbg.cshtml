@{
    ViewData["Title"] = "Вокална рок група „БабсБг“";

    var heroImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776085799/eo3mkvscmggwyf34lb4f.jpg";
    var contentImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776085832/w6yygyw0y90yrxylrfgc.jpg";
}

<div class="container py-5">

    <!-- HERO -->
    <div class="rounded-4 overflow-hidden mb-5 text-white d-flex align-items-center"
         style="min-height: 360px;
                background: linear-gradient(rgba(0,0,0,.65), rgba(0,0,0,.45)),
                url('@heroImage') center/cover no-repeat;">

        <div class="p-5">
            <p class="text-uppercase mb-2" style="letter-spacing: 2px;">Народно читалище „Искра-1860”</p>
            <h1 class="fw-bold mb-3">Вокална рок група „БабсБг“</h1>
            <p class="mb-0 col-lg-8 fs-5">
                Уникална музикална формация, която интерпретира световни поп и рок хитове
                с хумор и ново звучене на български език.
            </p>
        </div>
    </div>

    <!-- ЗА ГРУПАТА -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-lg-5">
            <div class="row align-items-center">

                <div class="col-lg-7">
                    <h2 class="mb-4">За групата</h2>
                    <p>
                        „БабсБг“ е вокална рок група, съставена от жени на възраст между 60 и 75 години.
                    </p>
                    <p>
                        Формацията интерпретира популярни поп и рок хитове със специално адаптирани
                        текстове на български език, които придават нов смисъл и хумористичен оттенък
                        на добре познати песни.
                    </p>
                </div>

                <div class="col-lg-5 text-center mt-4 mt-lg-0">
                    <img src="@contentImage"
                         class="img-fluid rounded-4 shadow-sm"
                         style="max-width: 105%; height: auto;"
                         alt="Вокална рок група БабсБг" />
                </div>

            </div>
        </div>
    </div>

    <!-- РЕПЕРТОАР -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4">Репертоар</h2>
            <p>
                В репертоара на „БабсБг“ са включени десет кавъра на световни музикални хитове,
                сред които емблематични песни на Queen („I Want to Break Free“),
                Rag’n’Bone Man („Human“), Michael Jackson / USA for Africa („We Are the World“),
                Madonna („Like a Prayer“), The Weather Girls („It’s Raining Men“),
                Irene Cara („What a Feeling“ от Flashdance), Metallica („Nothing Else Matters“),
                ABBA и други.
            </p>
        </div>
    </div>

    <!-- ПЪРВА ПЕСЕН -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4">Първа песен и създатели</h2>
            <p>
                Първата песен на групата е „I Want to Break Free“, представена с оригинален
                и закачлив български текст, разказващ историята на две съседки.
            </p>
            <p class="mb-0">
                Текстовете на песните са създадени от Петър Москов,
                а аранжиментите са дело на Боян Христов.
            </p>
        </div>
    </div>

    <!-- РЪКОВОДИТЕЛ -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4">Художествен ръководител</h2>
            <p class="mb-0">
                <strong>Стоян Петров</strong>
            </p>
        </div>
    </div>

    <!-- КОНТАКТИ -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4">Контакти</h2>

            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <strong>НЧ „Искра-1860”</strong>
                </li>
                <li class="list-group-item">
                    <strong>Адрес:</strong> 6100, гр. Казанлък, ул. „Искра” 1
                </li>
                <li class="list-group-item">
                    <strong>Тел./факс:</strong> +35943162986
                </li>
                <li class="list-group-item">
                    <strong>Email:</strong> iskrakz@abv.bg
                </li>
            </ul>
        </div>
    </div>

</div>
