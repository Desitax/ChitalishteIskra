@{
    ViewData["Title"] = "Детска театрална школа";

    var heroImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776089625/j1bojbbkkw1hhgwyhcaz.jpg";
    var contentImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776089598/cjeymvmgaar4urnozzsk.jpg";
}

<div class="container py-5" style="background-color: #fff9e8; border-radius: 28px;">

    <!-- HERO -->
    <div class="overflow-hidden mb-5 text-white d-flex align-items-center"
         style="min-height: 360px;
                border-radius: 30px;
                box-shadow: 0 12px 30px rgba(0,0,0,0.12);
                background: linear-gradient(rgba(0,0,0,.65), rgba(0,0,0,.45)),
                url('@heroImage') center/cover no-repeat;">

        <div class="p-5">
            <p class="text-uppercase mb-2" style="letter-spacing: 2px;">Народно читалище „Искра-1860”</p>
            <h1 class="fw-bold mb-3" style="font-size: 2.5rem;">Детска театрална школа</h1>
            <p class="mb-0 col-lg-8 fs-5">
                Пространство за творчество, въображение и развитие на деца чрез театралното изкуство.
            </p>
        </div>
    </div>

    <!-- ЗА ШКОЛАТА -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 24px; overflow: hidden;">
        <div class="card-body p-4 p-lg-5">
            <div class="row align-items-center gx-5">

                <!-- ТЕКСТ -->
                <div class="col-lg-7">
                    <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">За школата</h2>
                    <p style="line-height: 1.8; color: #4b5563;">
                        Детската театрална школа към Народно читалище „Искра-1860“ е пространство
                        за творчество, въображение и личностно развитие на деца на възраст от 7 до 13 години.
                    </p>
                    <p style="line-height: 1.8; color: #4b5563;">
                        В нея децата правят първите си стъпки в театралното изкуство чрез игра,
                        импровизация и сценична практика.
                    </p>
                    <p class="mb-0" style="line-height: 1.8; color: #4b5563;">
                        Обучението е насочено към развитие на сценична реч, актьорско присъствие,
                        работа в екип, емоционална изразност и увереност пред публика.
                    </p>
                </div>

                <!-- СНИМКА -->
                <div class="col-lg-5 mb-4 mb-lg-0">
                    <img src="@contentImage"
                         class="img-fluid shadow w-100"
                         style="max-width: 520px; margin: 0 auto; display: block; border-radius: 24px;"
                         alt="Детска театрална школа" />
                </div>

            </div>
        </div>
    </div>

    <!-- ОБУЧЕНИЕ -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 24px;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">Обучение и развитие</h2>
            <p class="mb-0" style="line-height: 1.8; color: #4b5563;">
                Чрез театъра децата усвояват важни умения като концентрация, комуникация и творческо мислене,
                като едновременно с това се докосват до класически и съвременни литературни текстове.
            </p>
        </div>
    </div>

    <!-- НАПРАВЛЕНИЯ -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 24px; overflow: hidden;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">Творчески направления</h2>

            <ul class="list-group list-group-flush" style="border-radius: 18px; overflow: hidden;">
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">Школа по художествено слово</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">Студио „Пантомима“</li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">Формация „Буфо“</li>
            </ul>

        </div>
    </div>

    <!-- РЪКОВОДИТЕЛ -->
    <div class="card border-0 shadow-sm" style="border-radius: 24px;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">Художествен ръководител</h2>
            <p class="mb-0" style="line-height: 1.8; color: #4b5563;">
                <strong>Светлана Бургазова</strong>
            </p>
        </div>
    </div>

</div>