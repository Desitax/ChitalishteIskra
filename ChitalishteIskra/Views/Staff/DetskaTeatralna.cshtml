@{
    ViewData["Title"] = "Детска театрална школа";

    var heroImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776089625/j1bojbbkkw1hhgwyhcaz.jpg";
    var contentImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776089598/cjeymvmgaar4urnozzsk.jpg";
}

<div class="container py-5">

    <!-- HERO -->
    <div class="rounded-4 overflow-hidden mb-5 text-white d-flex align-items-center"
         style="min-height: 360px;
                background: linear-gradient(rgba(0,0,0,.65), rgba(0,0,0,.45)),
                url('@heroImage') center/cover no-repeat;">

        <div class="p-5">
            <p class="text-uppercase mb-2" style="letter-spacing: 2px;">Народно читалище „Искра-1860”</p>
            <h1 class="fw-bold mb-3">Детска театрална школа</h1>
            <p class="mb-0 col-lg-8 fs-5">
                Пространство за творчество, въображение и развитие на деца чрез театралното изкуство.
            </p>
        </div>
    </div>

    <!-- ЗА ШКОЛАТА (СНИМКА ВДЯСНО) -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-lg-5">
            <div class="row align-items-center gx-5">

                <!-- ТЕКСТ -->
                <div class="col-lg-7">
                    <h2 class="mb-4">За школата</h2>
                    <p>
                        Детската театрална школа към Народно читалище „Искра-1860“ е пространство
                        за творчество, въображение и личностно развитие на деца на възраст от 7 до 13 години.
                    </p>
                    <p>
                        В нея децата правят първите си стъпки в театралното изкуство чрез игра,
                        импровизация и сценична практика.
                    </p>
                    <p>
                        Обучението е насочено към развитие на сценична реч, актьорско присъствие,
                        работа в екип, емоционална изразност и увереност пред публика.
                    </p>
                </div>

                <!-- СНИМКА -->
                <div class="col-lg-5 mb-4 mb-lg-0">
                    <img src="@contentImage"
                         class="img-fluid rounded-4 shadow w-100"
                         style="max-width: 520px; margin: 0 auto; display: block;"
                         alt="Детска театрална школа" />
                </div>

            </div>
        </div>
    </div>

    <!-- ОБУЧЕНИЕ -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4">Обучение и развитие</h2>
            <p>
                Чрез театъра децата усвояват важни умения като концентрация, комуникация и творческо мислене,
                като едновременно с това се докосват до класически и съвременни литературни текстове.
            </p>
        </div>
    </div>

    <!-- НАПРАВЛЕНИЯ -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4">Творчески направления</h2>

            <ul class="list-group list-group-flush">
                <li class="list-group-item">Школа по художествено слово</li>
                <li class="list-group-item">Студио „Пантомима“</li>
                <li class="list-group-item">Формация „Буфо“</li>
            </ul>

        </div>
    </div>

    <!-- РЪКОВОДИТЕЛ -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4">Художествен ръководител</h2>
            <p class="mb-0">
                <strong>Светлана Бургазова</strong>
            </p>
        </div>
    </div>

</div>