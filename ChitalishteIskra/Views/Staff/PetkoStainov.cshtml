@{
    ViewData["Title"] = "Смесен хор „Петко Стайнов“";

    var heroImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776088915/q9hysqh3qcameshac56i.jpg";
    var contentImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776088889/jxete8iqu4sbqevf2s8u.jpg";
}

<div class="container py-5" style="background-color: #fff9e8; border-radius: 28px;">

    <!-- HERO -->
    <div class="overflow-hidden mb-5 text-white d-flex align-items-center"
         style="min-height: 360px;
                border-radius: 30px;
                box-shadow: 0 12px 30px rgba(0,0,0,0.12);
                background: linear-gradient(rgba(0,0,0,.65), rgba(0,0,0,.45)),
                url('@heroImage') center/cover no-repeat;">

        <div class="p-5">
            <p class="text-uppercase mb-2" style="letter-spacing: 2px;">Народно читалище „Искра-1860”</p>
            <h1 class="fw-bold mb-3" style="font-size: 2.5rem;">Смесен хор „Петко Стайнов“</h1>
            <p class="mb-0 col-lg-8 fs-5">
                Една от водещите хорови формации в България с богата история и значими постижения.
            </p>
        </div>
    </div>

    <!-- ЗА ХОРА -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 24px; overflow: hidden;">
        <div class="card-body p-4 p-lg-5">
            <div class="row align-items-center gx-5">

                <!-- ТЕКСТ -->
                <div class="col-lg-7">
                    <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">За хора</h2>
                    <p style="line-height: 1.8; color: #4b5563;">
                        Смесен хор „Петко Стайнов“ е създаден през 1972 година по идея на големия
                        български композитор и почетен гражданин на Казанлък Петко Стайнов.
                    </p>
                    <p style="line-height: 1.8; color: #4b5563;">
                        С неговото основаване се завършва изграждането на първата в България хорова школа,
                        която включва Детски хор „Искра“, Хор на момчетата и Дамски камерен хор.
                    </p>
                    <p class="mb-0" style="line-height: 1.8; color: #4b5563;">
                        През годините хорът се утвърждава като водеща формация в хоровото изкуство
                        и е лауреат на всички републикански хорови фестивали.
                    </p>
                </div>

                <!-- СНИМКА -->
                <div class="col-lg-5 mb-4 mb-lg-0">
                    <img src="@contentImage"
                         class="img-fluid shadow w-100"
                         style="max-width: 520px; margin: 0 auto; display: block; border-radius: 24px;"
                         alt="Смесен хор Петко Стайнов" />
                </div>

            </div>
        </div>
    </div>

    <!-- РЕПЕРТОАР -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 24px;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">Репертоар</h2>
            <p class="mb-0" style="line-height: 1.8; color: #4b5563;">
                Репертоарът на Смесен хор „Петко Стайнов“ е богат и разнообразен и включва
                църковнославянски песнопения, обработки на народни песни, популярни песни от мюзикъли,
                хорове от известни опери и оперети, както и патриотични произведения.
            </p>
        </div>
    </div>

    <!-- НАГРАДИ -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 24px;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">Награди и дейност</h2>
            <p style="line-height: 1.8; color: #4b5563;">
                Хорът е носител на множество призови награди от национални и международни фестивали
                и конкурси.
            </p>
            <p class="mb-0" style="line-height: 1.8; color: #4b5563;">
                В своята дългогодишна история съставът реализира и звукозаписи за Златния фонд
                на Българското национално радио.
            </p>
        </div>
    </div>

    <!-- ЕКИП -->
    <div class="card border-0 shadow-sm" style="border-radius: 24px; overflow: hidden;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">Екип</h2>

            <ul class="list-group list-group-flush" style="border-radius: 18px; overflow: hidden;">
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">
                    <strong>Диригент:</strong> Младен Станев
                </li>
                <li class="list-group-item" style="padding: 16px 0; color: #4b5563;">
                    <strong>Корепетитор:</strong> Светослава Петрова
                </li>
            </ul>

        </div>
    </div>

</div>