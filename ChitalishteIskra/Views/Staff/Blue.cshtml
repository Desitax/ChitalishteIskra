@{
    ViewData["Title"] = "Школа по изобразително изкуство „Синьо“";

    var heroImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776090361/gjxznrod3x12hn49fcbb.jpg";
    var contentImage = "https://res.cloudinary.com/dxloy3tkq/image/upload/v1776090385/ym2c7hex7x6jnw5cs7zg.jpg";
}

<div class="container py-5" style="background-color: #fff9e8; border-radius: 28px;">

    <!-- HERO -->
    <div class="overflow-hidden mb-5 text-white d-flex align-items-center"
         style="min-height: 360px;
                border-radius: 30px;
                box-shadow: 0 12px 30px rgba(0,0,0,0.12);
                background: linear-gradient(rgba(0,0,0,.65), rgba(0,0,0,.45)),
                url('@heroImage') center/cover no-repeat;">

        <div class="p-5">
            <p class="text-uppercase mb-2" style="letter-spacing: 2px;">Народно читалище „Искра-1860”</p>
            <h1 class="fw-bold mb-3" style="font-size: 2.5rem;">Школа по изобразително изкуство „Синьо“</h1>
            <p class="mb-0 col-lg-8 fs-5">
                Творческо пространство за развитие на млади художници и изследване на изкуството.
            </p>
        </div>
    </div>

    <!-- ЗА ШКОЛАТА -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 24px; overflow: hidden;">
        <div class="card-body p-4 p-lg-5">
            <div class="row align-items-center gx-5">

                <!-- ТЕКСТ -->
                <div class="col-lg-7">
                    <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">За школата</h2>
                    <p class="mb-0" style="line-height: 1.8; color: #4b5563;">
                        Школа по изобразително изкуство „Синьо“ е открита на 10 април 2018 г.,
                        а още през първата си година реализира своята първа изложба,
                        доказвайки своя потенциал и отдаденост към изкуството.
                    </p>
                </div>

                <!-- СНИМКА -->
                <div class="col-lg-5 mb-4 mb-lg-0">
                    <img src="@contentImage"
                         class="img-fluid shadow w-100"
                         style="max-width: 520px; margin: 0 auto; display: block; border-radius: 24px;"
                         alt="Школа по изобразително изкуство Синьо" />
                </div>

            </div>
        </div>
    </div>

    <!-- ОБУЧЕНИЕ -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 24px;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">Обучение</h2>
            <p class="mb-0" style="line-height: 1.8; color: #4b5563;">
                Школата предлага изучаване на различни техники в живописта.
                Отскоро се провежда и подготвителен курс за желаещите да кандидатстват
                в художествени гимназии, като осигурява солидна база и творчески подход.
            </p>
        </div>
    </div>

    <!-- ПОСТИЖЕНИЯ -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 24px;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">Постижения</h2>
            <p style="line-height: 1.8; color: #4b5563;">
                В краткото си съществуване школата успя да се утвърди като значима част
                от творческото пространство за деца-художници не само в Казанлък,
                но и в цялата страна.
            </p>
            <p class="mb-0" style="line-height: 1.8; color: #4b5563;">
                Учениците на „Синьо“ са носители на над 30 престижни награди от национални
                и международни конкурси, включително и Световния конкурс за детска рисунка България, 2018.
            </p>
        </div>
    </div>

    <!-- РЪКОВОДИТЕЛ -->
    <div class="card border-0 shadow-sm" style="border-radius: 24px;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="mb-4" style="color: #7b1e3a; font-weight: 700;">Ръководител</h2>
            <p class="mb-0" style="line-height: 1.8; color: #4b5563;">
                <strong>Мариела Попова</strong>
            </p>
        </div>
    </div>

</div>